# Build settings of the test deployment (placemarks-web), read by
# scripts/deploy.mjs. Nothing here is secret — every value ships in the
# bundle. Keys and personal overrides go in deploy.env.local (git-ignored),
# which wins over this file; see OPERATIONS.md.

# A personal test deployment may use the public OSM API for lookups
# (spec/src/data-sources.md). Build-time only; never reaches the client.
PLACEMARKS_TEST_DEPLOY=1
VITE_OSM_API_URL=https://api.openstreetmap.org

VITE_SHARE_API_URL=https://placemarks-share.together-in-girona.workers.dev

VITE_MAP_TILES_URL=https://placemarks-tiles.together-in-girona.workers.dev/europe/{z}/{x}/{y}.mvt
VITE_MAP_GLYPHS_URL=https://placemarks-tiles.together-in-girona.workers.dev/fonts/{fontstack}/{range}.pbf
VITE_MAP_SPRITE_URL=https://placemarks-tiles.together-in-girona.workers.dev/sprites/v4/light
