# Development basemap options (book/src/data-sources.md — all dev-only defaults;
# production points at contracted/self-hosted deployments).
#
# OpenFreeMap (keyless, the default host) — pick a style:
#   OSM Bright (default):
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/bright
#   OSM Liberty (the Bright fork we used before):
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
#   Positron (muted, good under dense pin overlays):
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
#   Dark:
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
#
# VersaTiles (keyless, FLOSS, hosted by a non-commercial project):
# VITE_MAP_STYLE_URL=https://tiles.versatiles.org/assets/styles/colorful/style.json
#
# Stadia Maps (no key needed on localhost; also serves an OSM Bright variant —
# a production-contract candidate per book/src/tech-stack.md):
# VITE_MAP_STYLE_URL=https://tiles.stadiamaps.com/styles/osm_bright.json
#
# Fully offline / e2e: the local fixture style (no network at all):
# VITE_MAP_STYLE_URL=/test-style.json

# Force MSW request mocking in dev (search/OSM/Overpass served from fixtures):
# VITE_ENABLE_MSW=true
