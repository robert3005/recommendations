# Development basemap options (spec/src/data-sources.md — all dev-only defaults;
# production points at contracted/self-hosted deployments).
#
# Default: our own "plate" style (src/map/basemapStyle.ts) over the Protomaps
# Europe archive in our R2 bucket (pub-a5fdf113afab4f329db5d4a74129b60d.r2.dev),
# with glyphs and sprite from the same bucket. Setting VITE_MAP_STYLE_URL
# switches to a hosted style instead; VITE_MAP_PMTILES_URL always wins.
# For local work, extract a small region with the pmtiles CLI
# (https://github.com/protomaps/go-pmtiles) into public/ (gitignored), e.g.
#   pmtiles extract https://build.protomaps.com/<YYYYMMDD>.pmtiles \
#     public/tiles/lisbon.pmtiles --bbox=-9.30,38.65,-9.05,38.82
# VITE_MAP_PMTILES_URL=/tiles/lisbon.pmtiles
# Production builds must set all three explicitly (the build fails closed):
# VITE_MAP_PMTILES_URL=https://pub-a5fdf113afab4f329db5d4a74129b60d.r2.dev/europe.pmtiles
# VITE_MAP_GLYPHS_URL=https://pub-a5fdf113afab4f329db5d4a74129b60d.r2.dev/fonts/{fontstack}/{range}.pbf
# VITE_MAP_SPRITE_URL=https://pub-a5fdf113afab4f329db5d4a74129b60d.r2.dev/sprites/v4/light
#
# OpenFreeMap (keyless, worldwide) — pick a style:
#   Positron (quiet grey, closest to the plate):
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
#   OSM Bright (the previous default):
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/bright
#   OSM Liberty (the Bright fork we used before):
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
#   Dark:
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
#
# VersaTiles (keyless, FLOSS, hosted by a non-commercial project):
# VITE_MAP_STYLE_URL=https://tiles.versatiles.org/assets/styles/colorful/style.json
#
# Stadia Maps (no key needed on localhost; also serves an OSM Bright variant —
# a production-contract candidate per spec/src/tech-stack.md):
# VITE_MAP_STYLE_URL=https://tiles.stadiamaps.com/styles/osm_bright.json
#
# Fully offline / e2e: the local fixture style (no network at all):
# VITE_MAP_STYLE_URL=/test-style.json

# POI search geocoder (spec/src/data-sources.md §Geocoder). Default is the
# Photon demo — keyless but weak on venues, dev-only. Set "pelias" to use a
# Pelias-class autocomplete endpoint instead:
# VITE_GEOCODER=pelias
# Pelias base URL — required with VITE_GEOCODER=pelias; no keyless public demo
# exists. Stadia Maps, Geoapify, geocode.earth, or a self-hosted Pelias:
# VITE_PELIAS_URL=https://api.geocode.earth
# Optional key, sent as the api_key query parameter (Geoapify style):
# VITE_PELIAS_KEY=your-api-key

# Force MSW request mocking in dev (search/OSM lookup served from fixtures):
# VITE_ENABLE_MSW=true

# The share service. Empty uses the app origin for local/MSW development;
# production must point at the deployed HTTPS Worker.
# VITE_SHARE_API_URL=https://share.example.com
# The test deployment (Cloudflare Worker + D1, created 2026-11-23). It also
# carries sync (spec/src/sync.md), so pointing a dev server at it lets two
# browsers or devices pair for real:
# VITE_SHARE_API_URL=https://placemarks-share.together-in-girona.workers.dev
